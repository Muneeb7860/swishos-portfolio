# Sentry error tracking (https://sentry.io) — create a free project, then fill these in.
# Without these set, Sentry is disabled and the app runs exactly as before.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Only needed in CI/production for source-map upload — leave blank for local dev.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
